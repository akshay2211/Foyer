<?xml version="1.0" encoding="utf-8"?>
<!--
   API 31+ backup/transfer rules. Everything backs up by default; the HF token
   (its own prefs file) is a credential and is excluded from both channels so it
   never leaves the device via Google cloud backup or a device-to-device move.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="foyer_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="foyer_secrets.xml" />
    </device-transfer>
</data-extraction-rules>

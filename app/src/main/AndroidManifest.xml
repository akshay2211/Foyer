<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets a swipe-down on the home screen pull the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- On-device voice command ("ask me"). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Resolve a spoken contact name to a number for "message …". -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Download the on-device Gemma model. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The "limit reached" nudge notification (runtime permission on 13+,
         requested when the user sets a daily limit). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "set an alarm for 7" / "set a 10 minute timer" via the system clock app
         (install-time permission, auto-granted; required by ACTION_SET_ALARM). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Screen-time / anti-distraction (special "usage access" grant). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- A launcher needs to see every app that exposes a LAUNCHER activity. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foyer"
        tools:targetApi="31">

        <!-- Optional: enables the double-tap-to-lock gesture, nothing else. -->
        <receiver
            android:name=".LimitNudgeReceiver"
            android:exported="false" />

        <service
            android:name=".LockService"
            android:exported="false"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service_config" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets a swipe-down on the home screen pull the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- On-device voice command ("ask me"). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Resolve a spoken contact name to a number for "message …". -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Download the on-device Gemma model. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Screen-time / anti-distraction (special "usage access" grant). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- AICore (Gemini Nano) requires API 31; keep the launcher installable on
         24+ and gate the AI code at runtime to capable devices. -->
    <uses-sdk tools:overrideLibrary="com.google.ai.edge.aicore" />

    <!-- A launcher needs to see every app that exposes a LAUNCHER activity. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foyer"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
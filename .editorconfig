root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
indent_size = 4
ktlint_code_style = ktlint_official
# Composables are PascalCase functions; don't flag them.
ktlint_function_naming_ignore_when_annotated_with = Composable, Test
# Existing code favors readable long lines over wrapping churn.
max_line_length = off
